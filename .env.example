# Copy this file to .env.local. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key
# The previous Groq key appeared in tracked source and must be rotated.
GROQ_API_KEY=your_groq_api_key
# Server-only secret used to authorize provisional AI grading through Supabase.
AUTO_GRADING_RPC_SECRET=generate_a_long_random_secret
